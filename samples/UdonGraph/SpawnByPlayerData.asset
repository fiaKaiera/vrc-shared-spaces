  udonAssembly: ".data_start\r\n\r\n    .export persistenceKey\r\n    .export persistenceValue\r\n   
    .export spawnLocation\r\n    \r\n    __instance_0: %VRCSDKBaseVRCPlayerApi, null\r\n   
    __teleportPos_0: %UnityEngineVector3, null\r\n    __teleportRot_0: %UnityEngineQuaternion,
    null\r\n    __instance_1: %UnityEngineTransform, this\r\n    __instance_2: %UnityEngineTransform,
    this\r\n    __Boolean_0: %SystemBoolean, null\r\n    __instance_3: %VRCSDKBaseVRCPlayerApi,
    null\r\n    __obj_0: %SystemObject, null\r\n    onPlayerRestoredPlayer: %VRCSDKBaseVRCPlayerApi,
    null\r\n    __Boolean_1: %SystemBoolean, null\r\n    __a_0: %SystemString, null\r\n   
    __b_0: %SystemString, null\r\n    __player_0: %VRCSDKBaseVRCPlayerApi, null\r\n   
    __key_0: %SystemString, null\r\n    __instance_4: %VRCUdonUdonBehaviour, this\r\n   
    __eventName_0: %SystemString, null\r\n    __key_1: %SystemString, null\r\n   
    __value_0: %SystemString, null\r\n    persistenceKey: %SystemString, null\r\n   
    persistenceValue: %SystemString, null\r\n    spawnLocation: %UnityEngineTransform,
    this\r\n\r\n.data_end\r\n\r\n.code_start\r\n\r\n    .export Spawn\r\n    \r\n   
    Spawn:\r\n    \r\n        PUSH, __instance_0\r\n        EXTERN, \"VRCSDKBaseNetworking.__get_LocalPlayer__VRCSDKBaseVRCPlayerApi\"\r\n       
    PUSH, spawnLocation\r\n        PUSH, __instance_1\r\n        COPY\r\n       
    PUSH, __instance_1\r\n        PUSH, __teleportPos_0\r\n        EXTERN, \"UnityEngineTransform.__get_position__UnityEngineVector3\"\r\n       
    PUSH, spawnLocation\r\n        PUSH, __instance_2\r\n        COPY\r\n       
    PUSH, __instance_2\r\n        PUSH, __teleportRot_0\r\n        EXTERN, \"UnityEngineTransform.__get_rotation__UnityEngineQuaternion\"\r\n       
    PUSH, __instance_0\r\n        PUSH, __teleportPos_0\r\n        PUSH, __teleportRot_0\r\n       
    EXTERN, \"VRCSDKBaseVRCPlayerApi.__TeleportTo__UnityEngineVector3_UnityEngineQuaternion__SystemVoid\"\r\n       
    JUMP, 0xFFFFFFFC\r\n    \r\n    .export _onPlayerRestored\r\n    \r\n    _onPlayerRestored:\r\n   
    \r\n        PUSH, __instance_3\r\n        EXTERN, \"VRCSDKBaseNetworking.__get_LocalPlayer__VRCSDKBaseVRCPlayerApi\"\r\n       
    PUSH, onPlayerRestoredPlayer\r\n        PUSH, __obj_0\r\n        COPY\r\n       
    PUSH, __instance_3\r\n        PUSH, __obj_0\r\n        PUSH, __Boolean_0\r\n       
    EXTERN, \"VRCSDKBaseVRCPlayerApi.__Equals__SystemObject__SystemBoolean\"\r\n       
    PUSH, __Boolean_0\r\n        JUMP_IF_FALSE, 0x00000194\r\n        PUSH, __player_0\r\n       
    EXTERN, \"VRCSDKBaseNetworking.__get_LocalPlayer__VRCSDKBaseVRCPlayerApi\"\r\n       
    PUSH, persistenceKey\r\n        PUSH, __key_0\r\n        COPY\r\n        PUSH,
    __player_0\r\n        PUSH, __key_0\r\n        PUSH, __a_0\r\n        EXTERN,
    \"VRCSDK3PersistencePlayerData.__GetString__VRCSDKBaseVRCPlayerApi_SystemString__SystemString\"\r\n       
    PUSH, persistenceValue\r\n        PUSH, __b_0\r\n        COPY\r\n        PUSH,
    __a_0\r\n        PUSH, __b_0\r\n        PUSH, __Boolean_1\r\n        EXTERN,
    \"SystemString.__Equals__SystemString_SystemString__SystemBoolean\"\r\n       
    PUSH, __Boolean_1\r\n        JUMP_IF_FALSE, 0x0000018C\r\n        PUSH, __instance_4\r\n       
    PUSH, __eventName_0\r\n        EXTERN, \"VRCUdonCommonInterfacesIUdonEventReceiver.__SendCustomEvent__SystemString__SystemVoid\"\r\n       
    JUMP, 0x0000018C\r\n        JUMP, 0x00000194\r\n        JUMP, 0xFFFFFFFC\r\n   
    \r\n    .export SaveLocation\r\n    \r\n    SaveLocation:\r\n    \r\n       
    PUSH, persistenceKey\r\n        PUSH, __key_1\r\n        COPY\r\n        PUSH,
    persistenceValue\r\n        PUSH, __value_0\r\n        COPY\r\n        PUSH,
    __key_1\r\n        PUSH, __value_0\r\n        EXTERN, \"VRCSDK3PersistencePlayerData.__SetString__SystemString_SystemString__SystemVoid\"\r\n       
    JUMP, 0xFFFFFFFC\r\n    \r\n\r\n.code_end\r\n"
